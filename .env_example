# Copie para .env e ajuste. Variáveis já exportadas no shell têm precedência.

# Números (DDD + telefone) que disparam o alerta, separados por vírgula.
# Aceita também o formato com código do país e pontuação: +55 (67) 99999-9999
PINGZAP_NUMBERS=67999999999,67988888888

# Palavra-chave que a mensagem precisa conter para disparar o alerta.
# Deixe vazio para disparar com qualquer mensagem dos números acima.
PINGZAP_KEYWORD=/urgente

# Opcionais (os valores abaixo são os padrões).
#PINGZAP_MQTT_BROKER=wss://broker.emqx.io:8084/mqtt
#PINGZAP_MQTT_USERNAME=
#PINGZAP_MQTT_PASSWORD=
#PINGZAP_MQTT_CMD_TOPIC=esp32/unit01/cmd
#PINGZAP_MQTT_DATA_TOPIC=esp32/unit01/data
#PINGZAP_MQTT_ON_PAYLOAD=ON
#PINGZAP_MQTT_OFF_PAYLOAD=OFF
#PINGZAP_WHATSAPP_DB=file:whatsapp.db?_foreign_keys=on
