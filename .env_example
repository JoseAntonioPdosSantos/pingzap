# Copie para .env e ajuste. Variáveis já exportadas no shell têm precedência.
#
# Dispositivos, tópicos, bots, contatos e grupos são configurados na interface
# web (http://localhost:8080). Aqui fica só a infraestrutura.

# Login do pingzap no broker. Obrigatório no docker-compose, que também cria
# esse usuário no broker local (Mosquitto).
PINGZAP_MQTT_USERNAME=pingzap
PINGZAP_MQTT_PASSWORD=troque-esta-senha

# Login do ESP32 no broker local, criado pelo docker-compose. Use os mesmos
# valores em mqtt_user / mqtt_pass no firmware/pingzap/secrets.h.
ESP32_MQTT_USERNAME=esp32
ESP32_MQTT_PASSWORD=troque-esta-senha-tambem

# InfluxDB (onde o pingzap grava a telemetria) e Grafana (gráficos), criados
# pelo docker-compose. O token é usado pelo pingzap e pelo Grafana; gere um
# valor longo, por exemplo com: openssl rand -hex 32
INFLUXDB_PASSWORD=troque-esta-senha
INFLUXDB_TOKEN=troque-este-token
GRAFANA_PASSWORD=troque-esta-senha

# Fora do docker-compose, para gravar a telemetria num InfluxDB, defina:
#PINGZAP_INFLUX_URL=http://localhost:8086
#PINGZAP_INFLUX_TOKEN=
#PINGZAP_INFLUX_ORG=pingzap
#PINGZAP_INFLUX_BUCKET=pingzap

# Porta da interface web na máquina (docker-compose). Troque se a 8080 já
# estiver em uso; o api_url do firmware/pingzap/secrets.h usa a mesma porta.
#PINGZAP_WEB_PORT=8080

# Opcionais (os valores abaixo são os padrões). No docker-compose o broker é
# sempre o local (tcp://mosquitto:1883) e os bancos ficam em ./data.
#PINGZAP_MQTT_BROKER=wss://broker.emqx.io:8084/mqtt
#PINGZAP_HTTP_ADDR=:8080
#PINGZAP_DB=file:pingzap.db?_foreign_keys=on
#PINGZAP_WHATSAPP_DB=file:whatsapp.db?_foreign_keys=on

# Legado: antes da interface web o alerta era configurado aqui. Se estas
# variáveis existirem quando o banco ainda estiver vazio, o pingzap cria a
# partir delas um dispositivo e um bot de alerta, uma única vez; depois disso,
# edite pelo web.
#PINGZAP_NUMBERS=67999999999,67988888888
#PINGZAP_KEYWORD=/urgente
#PINGZAP_MQTT_CMD_TOPIC=esp32/unit01/cmd
#PINGZAP_MQTT_DATA_TOPIC=esp32/unit01/data
#PINGZAP_MQTT_ON_PAYLOAD=ON
#PINGZAP_MQTT_OFF_PAYLOAD=OFF
