{
  "uid": "pingzap-devices",
  "title": "pingzap — Dispositivos",
  "tags": [
    "pingzap"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-pingzap"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"pingzap\", tag: \"device\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"pingzap\", tag: \"device\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pingzap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pingzap"
          },
          "query": "from(bucket: \"pingzap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"online\" and r.device =~ /^${device:regex}$/)\n  |> last()\n  |> map(fn: (r) => ({r with _field: r.device}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
