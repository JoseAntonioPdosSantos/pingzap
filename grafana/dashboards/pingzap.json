      "title": "Pulsos do relé (portão)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pingzap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pingzap"
          },
          "query": "from(bucket: \"pingzap\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"event\" and r._value == \"PULSE\" and r.device =~ /^${device:regex}$/)\n  |> group(columns: [\"device\"])\n  |> count()\n  |> map(fn: (r) => ({r with _time: r._stop, _field: r.device}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> group(columns: [\"_field\"])"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
